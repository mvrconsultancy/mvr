# =============================================================================
# Frontend Environment Variables Template
# Copy to .env.local (NEVER commit .env.local)
# =============================================================================

# ── Local development ────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Vercel Production (set in Dashboard, not in .env.local) ─────────────────
# See vercel.production.env.example for copy-paste values.
#
# Required on Vercel (Production):
#   BACKEND_URL=https://<client-render-service>.onrender.com
#   NEXT_PUBLIC_APP_URL=https://www.mvrconsultants.org
#
# Do NOT set on Vercel: DATABASE_URL, JWT_*, REDIS_URL, RESEND_API_KEY
# Cloudinary secrets belong on Render only.

# Optional (unused by current frontend — uploads use backend sign endpoint)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
