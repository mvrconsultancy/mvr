# =============================================================================
# Vercel Production Environment Variables — copy into Vercel Dashboard
# =============================================================================
# Vercel → Project → Settings → Environment Variables → Production
# Root Directory must be: frontend
#
# Do NOT commit real secrets here. These are public URLs only.
# =============================================================================

# Required — server-only (SSR + /api/* rewrites to Render)
# Replace with client's actual Render service URL (no trailing slash)
BACKEND_URL=https://mvr-umqq.onrender.com

# Required — public canonical site URL (sitemap, robots, Open Graph)
NEXT_PUBLIC_APP_URL=https://www.mvrconsultants.org

# Optional — not used by current frontend code (Cloudinary is on Render)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
